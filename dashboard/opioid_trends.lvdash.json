                    {
                      "name": "year",
                      "expression": "`year`"
                    },
                    {
                      "name": "state",
                      "expression": "`state`"
                    },
                    {
                      "name": "dispensing_rate",
                      "expression": "CASE WHEN `complete_case` THEN `dispensing_rate` END"
                    },
                    {
                      "name": "overdose_count",
