                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "frame": {
                "title": "Mean county dispensing rate per 100 persons",
                "showTitle": true,
                "description": "Unweighted mean among counties with reported dispensing.",
                "showDescription": true
