{
  "datasets": [
    {
      "name": "county_panel",
      "displayName": "County-year coverage panel",
      "query": "SELECT *, CAST(missing_dispensing AS INT) AS missing_dispensing_n, CAST(missing_overdose AS INT) AS missing_overdose_n FROM workspace.capstone.county_year"
    },
    {
      "name": "quality",
      "displayName": "Unfiltered pipeline validation",
      "query": "SELECT * FROM workspace.capstone.quality_report"
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "County trends and coverage",
      "layout": [
        {
          "widget": {
            "name": "intro",
            "textbox_spec": "# U.S. Opioid Dispensing and Overdose Trends | 2020\u20132024\nDecember reported 12-month-ending overdose counts; suppressed values stay missing. Counts are not population-adjusted death rates. County dispensing means are unweighted, not state/national rates. Observed death subtotals depend on reporting coverage. Association does not establish causation. County identifiers are FIPS codes. Validation differences remain unresolved."
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "filter_year",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "county_panel",
                  "fields": [
                    {
                      "name": "year",
                      "expression": "`year`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "frame": {
                "title": "Year",
                "showTitle": true,
                "description": "",
                "showDescription": false
              },
              "encodings": {
                "fields": [
                  {
                    "fieldName": "year",
                    "queryName": "main_query"
                  }
                ]
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 2,
            "height": 2
          }
        },
